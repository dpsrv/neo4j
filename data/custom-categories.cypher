// Custom dating profile categories
// Run this to create categories that make sense for dating profiles

// Pets
CREATE (c:Item:Category {
  uri: 'dating:category:pets',
  prefLabel: ['Pets@en'],
  description: ['Animals you have or love@en'],
  enabled: true,
  itemCount: 0
});

